# The one OrcaSlicer version of ArtisanHub Farm.
#
# The farm's slicing service runs this release of OrcaSlicer, unmodified, from the
# official Linux AppImages. The ArtisanHub installer's optional OrcaSlicer desktop
# (linuxserver/orcaslicer) runs the same version: .github/workflows/orcaslicer-watch.yml
# moves this file to a new release only once linuxserver has published that release too,
# and the installer pins both images from the version recorded here.
ORCASLICER_VERSION=2.5.0
ORCASLICER_AMD64_SHA256=d13eb0a9cd618ed080ab6b82c64c0a60c4501aac91e88d5ac2c3b526fb141a7c
ORCASLICER_ARM64_SHA256=00a4fa0a2f9c1649abb8c438b0537ed1e58fed5206faa560c1c0fb4ab225f9cf
# The HTTP API around OrcaSlicer's command line (AGPL-3.0), built from this commit.
ORCA_SLICER_API_COMMIT=a628de172313b20206e5f0fa0ecac37d1fdc0dce
